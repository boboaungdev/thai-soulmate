// This is your Prisma schema file

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(cuid())

  name     String
  avatar   String?
  email    String  @unique
  password String
  role     Role    @default(USER)

  registerInterest RegisterInterest?
  notes            Note[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RegisterInterest {
  id String @id @default(cuid())

  prefix          String
  name            String
  dob             DateTime
  gender          String
  nationality     String
  currentLocation String

  email        String  @unique
  phoneCountry String
  phone        String
  source       String
  otherSource  String?

  status RegisterInterestStatus @default(PENDING)

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  notes Note[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Note {
  id      String   @id @default(cuid())
  message String
  type    NoteType

  registerInterestId String?
  registerInterest   RegisterInterest? @relation(fields: [registerInterestId], references: [id])

  applicationFormId String?
  applicationForm   ApplicationForm? @relation(fields: [applicationFormId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ApplicationForm {
  id       String @id @default(cuid())
  customId Int    @unique @default(autoincrement())

  personalDetails Json

  career Json

  appearance Json

  personality Json

  lifestyle Json

  relationshipGoals Json

  idealPartner Json

  financial Json

  photos Json

  notes Note[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  ADMIN
  STAFF
  USER
}

enum NoteType {
  REGISTER_INTEREST
  APPLICATION_FORM
}

enum RegisterInterestStatus {
  PENDING
  CONTACTED_EMAIL
  CONTACTED_PHONE
  CONTACTED_WHATSAPP
  COMPLETED
  NOT_INTERESTED
}
