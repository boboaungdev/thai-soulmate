generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid())

  name     String
  avatar   String?
  email    String  @unique
  password String
  role     Role    @default(MEMBER)

  registerInterest RegisterInterest?
  notes            Note[]
  soulmateNotes    TrackingNote[]
  emails           EmailMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RegisterInterest {
  id String @id @default(uuid())

  prefix                String
  name                  String
  dob                   DateTime
  gender                String
  nationality           String
  nationalityRegion     String
  currentLocation       String
  currentLocationRegion String

  email                String    @unique
  phoneCountry         String
  phone                String
  preferredContactDate DateTime?
  preferredContactTime String?
  source               String
  otherSource          String?

  status RegisterInterestStatus @default(RECEIVED)

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  notes Note[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Note {
  id      String   @id @default(uuid())
  message String
  type    NoteType

  registerInterestId String?
  registerInterest   RegisterInterest? @relation(fields: [registerInterestId], references: [id])

  applicationFormId String?
  applicationForm   ApplicationForm? @relation(fields: [applicationFormId], references: [id])

  profileId String?
  profile   Profile? @relation(fields: [profileId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ApplicationForm {
  id       String @id @default(uuid())
  customId Int    @unique @default(autoincrement())

  status ApplicationFormStatus @default(RECEIVED)

  personalDetails   Json
  career            Json
  appearance        Json
  personality       Json
  lifestyle         Json
  relationshipGoals Json
  idealPartner      Json
  financial         Json
  photos            Json

  membership Membership?

  profile Profile?

  notes Note[]

  asMale   Tracking[] @relation("MaleTracking")
  asFemale Tracking[] @relation("FemaleTracking")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Profile {
  id String @id @default(uuid())

  applicationFormId String          @unique
  applicationForm   ApplicationForm @relation(fields: [applicationFormId], references: [id], onDelete: Cascade)

  status ProfileStatus @default(PENDING)
  notes  Note[]

  folders ProfileFolder[]
  files   ProfileFile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProfileFolder {
  id        String        @id @default(uuid())
  name      String
  profileId String
  profile   Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  files     ProfileFile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profileId, name])
}

model ProfileFile {
  id         String         @id @default(uuid())
  name       String
  url        String
  r2Key      String
  size       Int
  mimeType   String
  folderId   String?
  folder     ProfileFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  profileId  String
  profile    Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  uploadedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ProfileStatus {
  PENDING
  COMPLETED
}

model Membership {
  id String @id @default(uuid())

  applicationFormId String?          @unique
  applicationForm   ApplicationForm? @relation(fields: [applicationFormId], references: [id], onDelete: Cascade)

  plan MembershipPlan @default(NONE)

  startsAt  DateTime?
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tracking {
  id     String          @id @default(uuid())
  male   ApplicationForm @relation("MaleTracking", fields: [maleId], references: [id])
  maleId String

  female   ApplicationForm @relation("FemaleTracking", fields: [femaleId], references: [id])
  femaleId String

  matchPercentage Int

  status            TrackingStatus   @default(INITIAL_CONNECT)
  completedStatuses TrackingStatus[] @default([INITIAL_CONNECT])
  closedFromStatus  TrackingStatus?

  notes TrackingNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TrackingNote {
  id      String           @id @default(uuid())
  message String
  type    TrackingNoteType

  trackingId String
  tracking   Tracking @relation(fields: [trackingId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WebsiteReview {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  firstImpression      Json
  easeOfUse            Json
  designBranding       Json
  understandingService Json
  trustSafety          Json
  contentQuality       Json
  registrationProcess  Json
  pricingValue         Json
  overallExperience    Json
  matchmakingSpecific  Json
  reviewerInfo         Json?
}

enum Role {
  DEV
  ADMIN
  STAFF
  MEMBER
}

enum NoteType {
  REGISTER_INTEREST
  APPLICATION_FORM
  PROFILE
}

enum RegisterInterestStatus {
  RECEIVED
  PENDING
  ACCEPTED
  DECLINED
}

enum ApplicationFormStatus {
  RECEIVED
  PENDING
  COMPLETED
  MATCHED
  CLOSED
}

enum MembershipPlan {
  NONE
  FEMALE_FREE
  FEMALE_VIP_ONE_MONTH
  FEMALE_VIP_THREE_MONTHS
  FEMALE_VIP_SIX_MONTHS
  MALE_ONE_MONTH
  MALE_THREE_MONTHS
  MALE_SIX_MONTHS
}

enum TrackingStatus {
  // 1
  INITIAL_CONNECT

  // 2
  BOTH_PROFILES_SENT

  // 3
  FEMALE_REVIEW
  FEMALE_THINKING
  FEMALE_REJECTED
  FEMALE_ACCEPTED

  // 4
  MALE_REVIEW
  MALE_THINKING
  MALE_REJECTED
  MALE_ACCEPTED

  // 5
  BOTH_PROFILES_ACCEPTED

  // 6
  FIRST_GOOGLE_MEET

  // 7
  SECOND_GOOGLE_MEET

  // 8
  FIRST_FOLLOW_UP

  // 9
  SECOND_FOLLOW_UP

  // 10
  THIRD_FOLLOW_UP

  // 11
  MATCHED
  CLOSED
}

enum TrackingNoteType {
  INITIAL_CONNECT
  MALE_PROFILE_SENT_TO_FEMALE
  FEMALE_PROFILE_SENT_TO_MALE
  FIRST_GOOGLE_MEET
  SECOND_GOOGLE_MEET
  THIRD_GOOGLE_MEET
  FINAL_MATCH
  CLOSED
}

enum EmailFolder {
  INBOX
  SENT
  DRAFT
  TRASH
  ARCHIVE
  SPAM
}

enum EmailDirection {
  INBOUND
  OUTBOUND
}

model EmailMessage {
  id        String         @id @default(uuid())
  resendId  String?        @unique
  mailbox   String // e.g. "info", "support", "contact", etc.
  folder    EmailFolder    @default(INBOX)
  direction EmailDirection @default(OUTBOUND)

  fromEmail String
  fromName  String?
  toEmails  String[]
  ccEmails  String[] @default([])
  bccEmails String[] @default([])
  replyTo   String?

  subject  String
  preview  String?
  bodyText String?
  bodyHtml String

  isRead     Boolean @default(false)
  isStarred  Boolean @default(false)
  isArchived Boolean @default(false)
  isTrash    Boolean @default(false)

  attachments EmailAttachment[]

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  sentAt     DateTime?
  receivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([mailbox, folder])
  @@index([fromEmail])
  @@index([createdAt])
}

model EmailAttachment {
  id String @id @default(uuid())

  emailId String
  email   EmailMessage @relation(fields: [emailId], references: [id], onDelete: Cascade)

  filename    String
  contentType String
  size        Int

  url   String
  r2Key String

  isInline  Boolean @default(false)
  contentId String?

  createdAt DateTime @default(now())

  @@index([emailId])
}

model MailboxSetting {
  id      String @id @default(uuid())
  mailbox String @unique

  displayName        String?
  notificationEmails String[] @default([])

  signatureText     String?
  signatureImageUrl String?
  signatureSize     String  @default("md")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
