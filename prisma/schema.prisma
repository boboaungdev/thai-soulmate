generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(cuid())

  name     String
  avatar   String?
  email    String  @unique
  password String
  role     Role    @default(MEMBER)

  registerInterest RegisterInterest?
  notes            Note[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RegisterInterest {
  id String @id @default(cuid())

  prefix          String
  name            String
  dob             DateTime
  gender          String
  nationality     String
  currentLocation String

  email        String  @unique
  phoneCountry String
  phone        String
  source       String
  otherSource  String?

  status RegisterInterestStatus @default(RECEIVED)

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  notes Note[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Note {
  id      String   @id @default(cuid())
  message String
  type    NoteType

  registerInterestId String?
  registerInterest   RegisterInterest? @relation(fields: [registerInterestId], references: [id])

  applicationFormId String?
  applicationForm   ApplicationForm? @relation(fields: [applicationFormId], references: [id])

  soulmateId String?
  soulmate   Soulmate? @relation(fields: [soulmateId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ApplicationForm {
  id       String @id @default(cuid())
  customId Int    @unique @default(autoincrement())

  status ApplicationFormStatus @default(RECEIVED)

  personalDetails   Json
  career            Json
  appearance        Json
  personality       Json
  lifestyle         Json
  relationshipGoals Json
  idealPartner      Json
  financial         Json
  photos            Json

  membership Membership?

  notes Note[]

  asMale   Soulmate[] @relation("MaleSoulmate")
  asFemale Soulmate[] @relation("FemaleSoulmate")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Membership {
  id String @id @default(cuid())

  applicationFormId String          @unique
  applicationForm   ApplicationForm @relation(fields: [applicationFormId], references: [id], onDelete: Cascade)

  plan MembershipPlan @default(NONE)

  startsAt  DateTime?
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Soulmate {
  id     String          @id @default(cuid())
  male   ApplicationForm @relation("MaleSoulmate", fields: [maleId], references: [id])
  maleId String

  female   ApplicationForm @relation("FemaleSoulmate", fields: [femaleId], references: [id])
  femaleId String

  status SoulmateStatus @default(INITIAL_CONNECT)

  notes Note[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([maleId, femaleId])
}

enum Role {
  DEV
  ADMIN
  STAFF
  MEMBER
}

enum NoteType {
  REGISTER_INTEREST
  APPLICATION_FORM
  SOULMATE
}

enum RegisterInterestStatus {
  RECEIVED
  PENDING
  ACCEPTED
  DECLINED
  CONTACTED_EMAIL
  CONTACTED_PHONE
  CONTACTED_WHATSAPP
}

enum ApplicationFormStatus {
  RECEIVED
  PENDING
  COMPLETED
  MATCHED
  CLOSED
}

enum MembershipPlan {
  NONE
  FEMALE_FREE
  FEMALE_VIP_ONE_MONTH
  FEMALE_VIP_THREE_MONTHS
  FEMALE_VIP_SIX_MONTHS
  MALE_ONE_MONTH
  MALE_THREE_MONTHS
  MALE_SIX_MONTHS
}

enum SoulmateStatus {
  INITIAL_CONNECT
  MALE_PROFILE_SENT
  FEMALE_PROFILE_SENT
  MALE_REJECT
  FEMALE_REJECT
  PROFILES_ACCEPTED
  FIRST_GOOGLE_MEET
  SECOND_GOOGLE_MEET
  FOLLOW_UP
}
